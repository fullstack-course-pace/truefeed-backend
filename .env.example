# Backend .env.example
NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string (do not commit real value)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# Session secret (do not commit real value)
SESSION_SECRET=replace-with-strong-secret

# Allowed frontend origin (exact URL)
FRONTEND_ORIGIN=https://truefeed.example.com

# Optional cookie domain for production
COOKIE_DOMAIN=truefeed.example.com

