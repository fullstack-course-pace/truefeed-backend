# Example environment file for TrueFeed backend
# Copy this to `.env` and fill in real values before running or building the container.

# Server
PORT=4000
NODE_ENV=production

# Session secret
SESSION_SECRET=change-this-to-a-secure-random-value

# Database URIs
DATABASE_URL=mongodb://localhost:27017/truefeed
ADMIN_URI=
EDITOR_URI=
READER_URI=

# Database name and collection names
DB_NAME=truefeed
USER_COLLECTION=users
POST_COLLECTION=posts
COMMENT_COLLECTION=comments

# Frontend origin for CORS (development)
FRONTEND_ORIGIN=http://localhost:3000
